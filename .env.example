# ============================================================
# SmartVoyage 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 应用配置
# ------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO

# 诚实声明：本项目数据均为脚本随机生成的 mock 数据（未接真实外部API）
MOCK_DATA=true

# ------------------------------------------------------------
# 大语言模型配置 (OpenAI 兼容接口，示例为阿里云 DashScope)
# 不配置 Key 时：Agent 服务可启动，但自然语言查询会明确报错；
# 可运行 scripts/demo_offline.py 与 scripts/demo_a2a_e2e.py 无 Key 验证全链路
# ------------------------------------------------------------
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL_NAME=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ------------------------------------------------------------
# 数据库配置
# DB_BACKEND=sqlite（默认，零依赖 demo）或 mysql
# ------------------------------------------------------------
DB_BACKEND=sqlite
# SQLITE_PATH=data/travel_demo.db

# MySQL 后端时以下生效（需先执行 sql/init_database.sql）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=travel_rag

# ------------------------------------------------------------
# Agent服务端口配置
# ------------------------------------------------------------
WEATHER_AGENT_HOST=0.0.0.0
WEATHER_AGENT_PORT=5005

TICKET_AGENT_HOST=0.0.0.0
TICKET_AGENT_PORT=5006

ORDER_AGENT_HOST=0.0.0.0
ORDER_AGENT_PORT=5007

# ------------------------------------------------------------
# MCP服务端口配置
# ------------------------------------------------------------
WEATHER_MCP_HOST=127.0.0.1
WEATHER_MCP_PORT=8000

TICKET_MCP_HOST=127.0.0.1
TICKET_MCP_PORT=8001

ORDER_MCP_HOST=127.0.0.1
ORDER_MCP_PORT=8002

# ------------------------------------------------------------
# Streamlit配置
# ------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
